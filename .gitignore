# =========================
# Monorepo Root
# =========================

# Planning / documentation files (not part of the project)
*.docx
*.pdf

# Root-level lockfiles (frontend has its own)
package-lock.json

# =========================
# Node / Next.js (frontend)
# =========================
# Frontend node_modules and build outputs are handled in clausewise-frontend/.gitignore
# This root .gitignore only handles root-level patterns

# =========================
# Python / Django (backend)
# =========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# =========================
# Environment / Secrets
# =========================
.env
.env.*
!.env.example

# =========================
# Docker
# =========================
*.log

# =========================
# IDE / OS
# =========================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# =========================
# Debug / Logs
# =========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

temp_keys.json
.env
.env.*
!.env.example